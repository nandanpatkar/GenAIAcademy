# Public Vercel origin that is permitted to make browser requests to the relay.
ALLOWED_ORIGINS=https://app.example.com
# Chrome Web Store extension ID. The server adds chrome-extension://<id> to CORS.
EXTENSION_ID=replace-with-your-chrome-web-store-extension-id
# Temporary beta option: allow any valid chrome-extension://<32-character-id> origin.
# Leave false for production once a stable store ID or device-token pairing is available.
ALLOW_ANY_CHROME_EXTENSION_ORIGIN=false
NODE_ENV=production
PORT=3000
# Keep Node private. Caddy is the only public entrypoint.
HOST=127.0.0.1
