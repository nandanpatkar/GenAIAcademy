  "examples": [
    "<p><strong>Input: </strong>5</p><p><strong>Output:</strong></p><p>5</p><p>4</p><p>3</p><p>2</p><p>1</p>",
    "<p><strong>Input: </strong>1</p><p><strong>Output:</strong></p><p>1</p>"
  ],
  "constraintsHtml": "<ul><li>1 <= n <= 100</li></ul>",
