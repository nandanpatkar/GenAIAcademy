  "levelType": "practical",
  "statementHtml": "<p>Given an integer n.Generate all possible combinations of well-formed <strong>parentheses</strong> of length <strong>2 x N</strong>.</p>",
  "examples": [
    "<p><strong>Input :</strong> n = 3</p><p><strong>Output :</strong> [ \"((()))\" , \"(()())\" , \"(())()\" , \"()(())\" , \"()()()\" ]</p>",
    "<p><strong>Input :</strong> 2</p><p><strong>Output :</strong> [ \"(())\" , \"()()\" ]</p>",
    "<p><strong>Input :</strong> 1</p>"
  ],
  "constraintsHtml": "<ul><li>1 <= n <= 8</li></ul>",
