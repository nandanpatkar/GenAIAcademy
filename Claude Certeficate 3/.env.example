# Copy to `.env` and fill in. `.env` is git-ignored; this file is not.
#
# Key for the OpenAI-compatible endpoint at https://api.tokenrouter.com/v1.
# Used only by server/chat-proxy.mjs, on the Node side of the app.
TOKENROUTER_API_KEY=

# Optional. Defaults to moonshotai/kimi-k3-free.
TOKENROUTER_MODEL=moonshotai/kimi-k3-free
