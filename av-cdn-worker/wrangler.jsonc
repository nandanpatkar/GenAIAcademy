{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "av-cdn",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // The bucket is bound privately. It is NOT made public via r2.dev — this
  // Worker is the only way in, which is why r2.dev's rate limit never applies.
  "r2_buckets": [
    {
      "binding": "AV_BUCKET",
      "bucket_name": "av-archive"
    }
  ],

  "vars": {
    // Browsers allowed to fetch(). Images in <img> tags ignore CORS entirely,
    // so this only governs the markdown fetches the reader makes.
    // learn-genaiacademy.in is the production custom domain. The .vercel.app
    // alias this project actually deploys to is kept alongside it so the old
    // URL keeps working (gen-ai-academy.vercel.app, listed here previously, is
    // a different account's project — see JOB_AGENT_DEPLOY.md).
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://learn-genaiacademy.in,https://www.learn-genaiacademy.in,https://gen-ai-academy-umber.vercel.app",

    // Also allow Vercel preview deployments (gen-ai-academy-*.vercel.app).
    "ALLOWED_ORIGIN_SUFFIX": ".vercel.app"
  },

  "observability": {
    "enabled": true
  }
}
