{
  "functions": {
    "api/**/*.js": {
      "excludeFiles": "{public/**,reference/**,themissingmanual/**,src/**,system-design-simulator/**,course_data*,scraped_data.json}"
    },
    "api/**/*.py": {
      "excludeFiles": "{public/**,reference/**,themissingmanual/**,src/**,system-design-simulator/**,course_data*,scraped_data.json}"
    }
  },
  "rewrites": [
    { "source": "/notion-api/(.*)", "destination": "https://api.notion.com/$1" },
    { "source": "/graphql", "destination": "/api/graphql" },
    { "source": "/api/copilot/:path*", "destination": "/api/copilot" }
  ],
  "redirects": [
    { "source": "/draw", "destination": "/k8sgames/draw.html", "permanent": true }
  ]
}
